{
  "name": "kkebi-clinic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:e2e:smoke": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/auth.login.spec.ts tests/e2e/session-realtime-smoke.spec.ts tests/e2e/session-sse-reconnect.smoke.spec.ts tests/e2e/summary-submit-smoke.spec.ts",
    "test:e2e:critical": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/app-critical-user-flow.spec.ts tests/e2e/en-critical-routes.spec.ts",
    "test:e2e:ui": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test --ui",
    "lighthouse:en:all": "node scripts/lighthouse-en-pages.mjs",
    "lighthouse:en:critical": "node scripts/lighthouse-en-critical.mjs",
    "lighthouse:en:all:auth": "node scripts/lighthouse-en-pages-auth.mjs",
    "generate:types": "curl -s 'http://ec2-52-79-154-149.ap-northeast-2.compute.amazonaws.com/api-docs/%EC%A0%84%EC%B2%B4' -o openapi.json && openapi-typescript openapi.json -o src/shared/api/generated-types.ts",
    "i18n:sync": "node scripts/sync-i18n-from-csv.mjs /tmp/i18n_sheet.csv",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.0.10",
    "next-intl": "^4.8.2",
    "react": "19.2.1",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.71.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "lighthouse": "^13.0.3",
    "lint-staged": "^16.2.7",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
